APP_NAME="Satyajeet Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging Configuration
# Local: 'stack' or 'single' | Vercel Serverless: 'stderr'
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (MySQL / TiDB Cloud)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql

# === Local XAMPP MySQL Configuration ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=

# === Production TiDB Cloud Configuration (Set in Vercel Environment Variables) ===
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=portfolio
# DB_USERNAME=xxxxxx.root
# DB_PASSWORD=your_tidb_password
# MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

# -----------------------------------------------------------------------------
# Session Configuration
# Local: 'database' or 'file' | Vercel Serverless: 'cookie' (stateless) or 'database'
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Cache & Queue Configuration
# Vercel Serverless: CACHE_STORE=database, QUEUE_CONNECTION=sync
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# External Persistent Cloud Storage (AWS S3 / Cloudflare R2 / MinIO)
# Required on Vercel Serverless for persistent file uploads (avatar, resume, images)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
